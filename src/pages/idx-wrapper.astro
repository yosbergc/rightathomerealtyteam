---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="IDX Wrapper | Right At Home Realty Team"
  description="Property search and IDX listings for Right At Home Realty Team."
  locale="en"
  path="/idx-wrapper"
  alternates={{ en: '/idx-wrapper', es: '/search' }}
  noindex
  autoLocaleRedirect={false}
  baseHref="https://rightathomerealtyteam.com/"
>
  <div id="idxStart" style="display: none;"></div>
  <div id="idxStop" style="display: none;"></div>
</BaseLayout>
