---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="Property Search | Right At Home Realty Team"
  description="Search homes across North Carolina and South Carolina with Right At Home Realty Team."
  locale="en"
  path="/search"
>
  <section class="pt-32 pb-20 md:pt-40 md:pb-28">
    <script
      is:inline
      charset="UTF-8"
      src={siteConfig.idxSearchPageBuilderSrc}
    ></script>
  </section>
</BaseLayout>
