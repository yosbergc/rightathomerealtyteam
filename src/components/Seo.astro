---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { siteConfig } from '../config/site';
import { absoluteUrl } from '../utils/content';
import { localizedPath } from '../i18n';
import type { Locale } from '../content.config';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
  image?: string | ImageMetadata;
  alternates?: { en: string; es: string };
  type?: 'website' | 'article';
  jsonLd?: object[];
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  locale,
  path,
  image,
  alternates,
  type = 'website',
  jsonLd = [],
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const canonical = absoluteUrl(path);
const defaultImage = absoluteUrl('/og-image.webp');
let ogImage = typeof image === 'string' ? image : undefined;
let ogImageWidth: number | undefined;
let ogImageHeight: number | undefined;

if (!ogImage && image) {
  const optimized = await getImage({ src: image as ImageMetadata, width: 1200 });
  ogImage = absoluteUrl(optimized.src);
  ogImageWidth = Number(optimized.attributes.width) || undefined;
  ogImageHeight = Number(optimized.attributes.height) || undefined;
}
if (!ogImage) {
  ogImageWidth = 1024;
  ogImageHeight = 539;
}

const ogImageUrl = ogImage ?? defaultImage;
const ogImageAlt = title;
const lang = locale === 'es' ? 'es' : 'en';
const alternateEn = absoluteUrl(alternates?.en ?? path);
const alternateEs = absoluteUrl(alternates?.es ?? (locale === 'es' ? path : localizedPath(path, 'es')));
const xDefault = alternateEn;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="generator" content="Astro" />
<meta name="robots" content={noindex ? 'noindex, max-image-preview:large' : 'max-image-preview:large'} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate" hreflang={lang} href={absoluteUrl(path)} />
<link rel="alternate" hreflang={locale === 'en' ? 'es' : 'en'} href={locale === 'en' ? alternateEs : alternateEn} />
<link rel="alternate" hreflang="x-default" href={xDefault} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
<meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_ES'} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
{ogImageWidth !== undefined && <meta property="og:image:width" content={String(ogImageWidth)} />}
{ogImageHeight !== undefined && <meta property="og:image:height" content={String(ogImageHeight)} />}
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />
{
  type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />
}
{
  type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />
}
{
  jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)
}