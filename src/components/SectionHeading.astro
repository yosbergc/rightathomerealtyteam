---
import Icon from './Icon.astro';

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  icon?: 'house' | 'star' | 'quill';
  as?: 'h1' | 'h2' | 'h3';
  tone?: 'dark' | 'light' | 'onWhite';
}

const { eyebrow, title, description, align = 'left', icon = 'house', as = 'h2', tone = 'dark' } = Astro.props;
const headingClass = 'heading-section mt-3';
const eyebrowClass =
  tone === 'light' ? 'eyebrow text-white/80' : tone === 'onWhite' ? 'eyebrow text-black/70' : 'eyebrow';
const titleClass =
  tone === 'light' ? `${headingClass} text-white` : tone === 'onWhite' ? `${headingClass} text-black` : headingClass;
const descriptionClass =
  tone === 'light'
    ? 'text-body mt-4 text-white/70'
    : tone === 'onWhite'
      ? 'text-body mt-4 text-black/70'
      : 'text-body mt-4 text-muted';
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  <p class={eyebrowClass}>
    <Icon name={icon} class={icon === 'house' ? 'h-[11px] w-3 text-quote' : 'h-4 w-4 text-quote'} />
    {eyebrow}
  </p>
  {as === 'h1' ? (
    <h1 class={titleClass}>{title}</h1>
  ) : as === 'h3' ? (
    <h3 class={titleClass}>{title}</h3>
  ) : (
    <h2 class={titleClass}>{title}</h2>
  )}
  {
    description && (
      <p class:list={[descriptionClass, align === 'center' && 'mx-auto']}>
        {description}
      </p>
    )
  }
</div>