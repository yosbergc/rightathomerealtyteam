---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import ContactForm from '../ContactForm.astro';
import PropertyMap from '../PropertyMap.astro';
import { siteConfig } from '../../config/site';
import { getDictionary } from '../../i18n';
import { imageMap } from '../../utils/images';
import {
  buildOrganizationJsonLd,
  buildWebPageJsonLd,
  buildBreadcrumbJsonLd,
} from '../../utils/seo';
import { absoluteUrl } from '../../utils/content';
import type { Locale } from '../../content.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const path = locale === 'es' ? '/es/contacto' : '/contact';
const rootPath = locale === 'es' ? '/es' : '/';

const jsonLd = [
  buildOrganizationJsonLd(),
  buildWebPageJsonLd(t.seoContactTitle, path, t.seoContactDescription),
  buildBreadcrumbJsonLd([
    { name: 'Home', url: absoluteUrl(rootPath) },
    { name: t.contact, url: absoluteUrl(path) },
  ]),
];
---

<BaseLayout
  title={t.seoContactTitle}
  description={t.seoContactDescription}
  locale={locale}
  path={path}
  image={imageMap.hero}
  jsonLd={jsonLd}
>
  <section class="section-pad pb-10 pt-32 md:pt-40">
    <div class="container-site grid items-center gap-12 lg:grid-cols-2">
      <div data-reveal>
        <p class="eyebrow">
          <Icon name="house" class="h-[11px] w-3 text-quote" />
          {t.contactHeroEyebrow}
        </p>
        <h1 class="heading-hero mt-4 text-[40px] md:text-[52px]">{t.contactHeroTitle}</h1>
        <p class="text-body mt-5 text-muted">{t.contactHeroSubtitle}</p>
        <div class="mt-10 overflow-hidden rounded-[12px]">
          <Image
            src={imageMap.hero}
            alt=""
            class="aspect-[16/9] w-full object-cover"
            width={1920}
            height={1080}
            sizes="(min-width: 1200px) 560px, 100vw"
            loading="eager"
            decoding="async"
            aria-hidden="true"
          />
        </div>
      </div>
      <div data-reveal class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {t.contactInfoCards.map((card, index) => {
          const icons = ['phone', 'mail', 'location', 'house'] as const;
          return (
            <div class="card-surface flex items-start gap-4 p-6">
              <span class="icon-chip flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-surface">
                <Icon name={icons[index] ?? 'phone'} class="h-5 w-5 text-brand" />
              </span>
              <div class="min-w-0">
                <p class="text-sm text-muted">{card.label}</p>
                {card.href ? (
                  <a
                    href={card.href}
                    class="mt-1 block break-words font-semibold text-white transition-colors hover:text-brand"
                  >
                    {card.value}
                  </a>
                ) : (
                  <p class="mt-1 break-words font-semibold text-white">{card.value}</p>
                )}
              </div>
            </div>
          );
        })}
        <div class="sm:col-span-2">
          <PropertyMap locale={locale} embedUrl={siteConfig.contactMapEmbed} compact />
        </div>
      </div>
    </div>
  </section>

  <section id="contact-form" class="section-pad pt-10">
    <div class="container-site">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
        <div data-reveal>
          <p class="eyebrow">
            <Icon name="house" class="h-[11px] w-3 text-quote" />
            {t.contactHeroEyebrow}
          </p>
          <h2 class="heading-section mt-3">{t.contactFormTitle}</h2>
          <p class="text-body mt-4 text-muted">{t.contactFormParagraph}</p>
          <div class="mt-8 hidden overflow-hidden rounded-[12px] lg:block">
            <Image
              src={imageMap.aboutCommunity}
              alt=""
              class="aspect-[4/3] w-full object-cover"
              width={641}
              height={1000}
              aria-hidden="true"
            />
          </div>
        </div>
        <div data-reveal>
          <ContactForm locale={locale} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>