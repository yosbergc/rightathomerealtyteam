---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../SectionHeading.astro';
import TeamBios from '../TeamBios.astro';
import TestimonialCarousel from '../TestimonialCarousel.astro';
import CtaSection from '../CtaSection.astro';
import FaqAccordion from '../FaqAccordion.astro';
import { getDictionary, localizedPath } from '../../i18n';
import { imageMap } from '../../utils/images';
import {
  buildOrganizationJsonLd,
  buildWebPageJsonLd,
  buildBreadcrumbJsonLd,
} from '../../utils/seo';
import { absoluteUrl } from '../../utils/content';
import type { Locale } from '../../content.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const path = locale === 'es' ? '/es/nosotros' : '/about';
const rootPath = locale === 'es' ? '/es' : '/';

const jsonLd = [
  buildOrganizationJsonLd(),
  buildWebPageJsonLd(t.seoAboutTitle, path, t.seoAboutDescription),
  buildBreadcrumbJsonLd([
    { name: 'Home', url: absoluteUrl(rootPath) },
    { name: t.about, url: absoluteUrl(path) },
  ]),
];
---

<BaseLayout
  title={t.seoAboutTitle}
  description={t.seoAboutDescription}
  locale={locale}
  path={path}
  image={imageMap.aboutHeroImage}
  jsonLd={jsonLd}
>
  <section class="relative overflow-hidden text-white">
    <Image
      src={imageMap.aboutHeroImage}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      width={2100}
      height={749}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-black/65" aria-hidden="true"></div>
    <div class="container-site relative z-10 flex min-h-[60svh] flex-col justify-end pb-14 pt-40">
      <div data-reveal>
        <p class="eyebrow text-white">{t.aboutHeroEyebrow}</p>
        <h1 class="heading-hero mt-4 max-w-3xl text-white">{t.aboutHeroTitle}</h1>
      </div>
      <div data-reveal class="mt-10 grid max-w-3xl grid-cols-2 gap-6 sm:grid-cols-4">
        {t.aboutHeroFacts.map((fact) => (
          <div>
            <p class="text-[22px] font-semibold">{fact.label}</p>
            <p class="mt-1 text-sm text-white/70">{fact.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-site">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
        <div data-reveal>
          <SectionHeading eyebrow={t.aboutStoryEyebrow} title={t.aboutStoryTitle} />
          <div class="mt-6 grid gap-5 text-body">
            {t.aboutStoryParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <a href={localizedPath('/contact', locale)} class="btn btn-primary mt-8">
            {t.contactUs}
          </a>
        </div>
        <div data-reveal class="grid gap-5">
          {t.valueBadges.map((badge) => (
            <div class="card-surface flex items-start gap-4 p-6">
              <span class="icon-chip mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-surface">
                <span class="h-5 w-5 rounded-full bg-brand" aria-hidden="true"></span>
              </span>
              <div>
                <h3 class="heading-card">{badge.title}</h3>
                <p class="text-body mt-2 text-muted">{badge.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <TeamBios locale={locale} />

  <section class="section-pad">
    <div class="container-site">
      <div data-reveal>
        <SectionHeading eyebrow={t.valuesEyebrow} title={t.valuesTitle} />
      </div>
      <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-3">
        {t.values.map((value) => (
          <div data-reveal class="rounded-[12px] bg-surface p-7">
            <span class="icon-chip flex h-12 w-12 items-center justify-center rounded-full bg-white">
              <span class="h-5 w-5 rounded-full bg-brand" aria-hidden="true"></span>
            </span>
            <h3 class="heading-card mt-5">{value.title}</h3>
            <p class="text-body mt-3 text-muted">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="testimonial" class="section-pad bg-white text-black">
    <div class="container-site">
      <div data-reveal>
        <SectionHeading
          tone="onWhite"
          eyebrow={t.testimonialsEyebrow}
          title={t.testimonialsTitle}
        />
      </div>
      <div class="mt-12">
        <TestimonialCarousel testimonials={t.testimonialsList} />
      </div>
    </div>
  </section>

  <CtaSection locale={locale} />

  <section id="faq" class="section-pad">
    <div class="container-site max-w-3xl">
      <div data-reveal>
        <SectionHeading eyebrow={t.faqEyebrow} title={t.faqTitle} />
        <p class="text-body mt-4 text-muted">
          {t.faqHelper}
        </p>
      </div>
      <FaqAccordion faqs={t.faqsList} />
    </div>
  </section>
</BaseLayout>