---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import IdxPropertySearch from '../IdxPropertySearch.astro';
import PropertyGrid from '../PropertyGrid.astro';
import CategoryCard from '../CategoryCard.astro';
import TeamSection from '../TeamSection.astro';
import TestimonialCarousel from '../TestimonialCarousel.astro';
import CtaSection from '../CtaSection.astro';
import FaqAccordion from '../FaqAccordion.astro';
import { siteConfig } from '../../config/site';
import { getDictionary, localizedPath } from '../../i18n';
import { getFeaturedProperties, getCategories } from '../../utils/content';
import { imageMap } from '../../utils/images';
import {
  buildOrganizationJsonLd,
  buildWebsiteJsonLd,
  buildWebPageJsonLd,
  buildBreadcrumbJsonLd,
} from '../../utils/seo';
import type { Locale } from '../../content.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const path = locale === 'es' ? '/es' : '/';
const [featuredProperties, categories] = await Promise.all([
  getFeaturedProperties(locale, 6),
  getCategories(locale),
]);

const searchPlaceholder =
  locale === 'es' ? 'Busca por dirección, ciudad, condado o código postal' : 'Search for address, city, county, or zipcode';

const jsonLd = [
  buildOrganizationJsonLd(),
  buildWebsiteJsonLd(),
  buildWebPageJsonLd(t.seoHomeTitle, siteConfig.domain, t.seoHomeDescription),
  buildBreadcrumbJsonLd([{ name: 'Home', url: siteConfig.domain }]),
];
---

<BaseLayout
  title={t.seoHomeTitle}
  description={t.seoHomeDescription}
  locale={locale}
  path={path}
  headerVariant="transparent"
  jsonLd={jsonLd}
>
  <section class="relative flex min-h-[100svh] items-center overflow-hidden text-white">
    <Image
      src={imageMap.hero}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      width={1920}
      height={1080}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-black/60" aria-hidden="true"></div>
    <div class="container-site relative z-10 py-32 md:py-40">
      <div class="grid items-center gap-14 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
        <div data-reveal>
          <p class="flex flex-wrap items-center gap-3 text-[15px] font-medium text-white/90">
            <Icon name="house" class="h-[11px] w-3 text-[#C89B3C]" />
            {t.heroEyebrow}
            <span class="badge-pill bg-[#C89B3C] px-3 py-1.5 text-[13px] font-semibold">
              {siteConfig.heroBadge}
            </span>
          </p>
          <h1 class="heading-hero mt-4 max-w-xl text-white">{t.heroTitle}</h1>
          <p class="mt-6 max-w-xl text-[17px] leading-[1.5] text-white/85">{t.heroSubtitle}</p>
          <div class="mt-9 max-w-2xl">
            <IdxPropertySearch placeholder={searchPlaceholder} />
          </div>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={localizedPath('/contact', locale)} class="btn btn-primary">
              {t.heroCtaWorth}
            </a>
            <a href="#listings" class="btn btn-outline">
              {t.heroCtaSearch}
            </a>
            <a href={siteConfig.phoneHref} class="btn btn-outline">
              {t.heroCtaCall}
            </a>
          </div>
        </div>
        <div data-reveal class="hidden justify-self-end lg:block">
          <div class="relative max-w-[380px]">
            <Image
              src={imageMap.aboutCommunity}
              alt="The Right At Home Realty Team"
              class="w-full rounded-[12px] object-cover object-top"
              width={641}
              height={1000}
              sizes="380px"
              loading="lazy"
              decoding="async"
            />
            <span class="badge-pill absolute bottom-4 left-4 bg-[#C89B3C] px-4 py-2 text-[15px] font-semibold">
              {siteConfig.heroBadge}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-site">
      <div class="grid gap-8 md:grid-cols-3">
        {t.values.map((value) => (
          <div data-reveal class="rounded-[12px] bg-surface p-8">
            <span class="icon-chip flex h-12 w-12 items-center justify-center rounded-full bg-white">
              <span class="h-5 w-5 rounded-full bg-brand" aria-hidden="true"></span>
            </span>
            <h2 class="heading-card mt-5">{value.title}</h2>
            <p class="text-body mt-3 text-muted">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
        <div data-reveal>
          <SectionHeading eyebrow={t.aboutEyebrow} title={t.aboutTitle} />
          <p class="text-body mt-5">{t.aboutParagraph}</p>
          <a href={localizedPath('/about', locale)} class="btn btn-outline-dark mt-8">
            {t.about}
          </a>
        </div>
        <div data-reveal>
          <Image
            src={imageMap.aboutCommunity}
            alt="Right At Home Realty serving the community"
            class="w-full rounded-[12px] object-cover"
            width={641}
            height={1000}
          />
        </div>
      </div>
    </div>
  </section>

  <TeamSection locale={locale} />

  <section id="listings" class="section-pad bg-surface/40">
    <div class="container-site">
      <div data-reveal>
        <SectionHeading
          eyebrow={t.listingsEyebrow}
          title={t.listingsTitle}
          description={t.listingsParagraph}
        />
      </div>
      <div class="mt-12">
        <PropertyGrid properties={featuredProperties} locale={locale} />
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-site">
      <div data-reveal>
        <SectionHeading
          eyebrow={t.categoriesEyebrow}
          title={t.categoriesTitle}
          description={t.categoriesParagraph}
        />
      </div>
      <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map((category, index) => (
          <div data-reveal>
            <CategoryCard category={category} locale={locale} index={index + 1} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="testimonial" class="section-pad bg-white text-black">
    <div class="container-site">
      <div data-reveal>
        <SectionHeading
          tone="onWhite"
          eyebrow={t.testimonialsEyebrow}
          title={t.testimonialsTitle}
        />
      </div>
      <div class="mt-12">
        <TestimonialCarousel testimonials={t.testimonialsList} />
      </div>
    </div>
  </section>

  <CtaSection locale={locale} image={imageMap.hero} />

  <section id="faq" class="section-pad">
    <div class="container-site max-w-3xl">
      <div data-reveal>
        <SectionHeading eyebrow={t.faqEyebrow} title={t.faqTitle} />
        <p class="text-body mt-4 text-muted">
          {t.faqHelper}
        </p>
      </div>
      <FaqAccordion faqs={t.faqsList} />
    </div>
  </section>
</BaseLayout>