---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../SectionHeading.astro';
import BlogGrid from '../BlogGrid.astro';
import { getDictionary } from '../../i18n';
import { getPosts } from '../../utils/content';
import {
  buildOrganizationJsonLd,
  buildWebPageJsonLd,
  buildBreadcrumbJsonLd,
} from '../../utils/seo';
import { absoluteUrl } from '../../utils/content';
import type { Locale } from '../../content.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const path = locale === 'es' ? '/es/blog' : '/blog';
const posts = await getPosts(locale);
const rootPath = locale === 'es' ? '/es' : '/';

const jsonLd = [
  buildOrganizationJsonLd(),
  buildWebPageJsonLd(t.seoBlogTitle, path, t.seoBlogDescription),
  buildBreadcrumbJsonLd([
    { name: 'Home', url: absoluteUrl(rootPath) },
    { name: t.blog, url: absoluteUrl(path) },
  ]),
];
---

<BaseLayout
  title={t.seoBlogTitle}
  description={t.seoBlogDescription}
  locale={locale}
  path={path}
  jsonLd={jsonLd}
>
  <section class="section-pad pb-10 pt-32 md:pt-40">
    <div class="container-site">
      <div data-reveal>
        <SectionHeading
          align="center"
          as="h1" eyebrow={t.blogEyebrow}
          title={t.blogTitle}
          description={t.blogSubtitle}
        />
      </div>
    </div>
  </section>
  <section class="pb-20 md:pb-28">
    <div class="container-site">
      <BlogGrid posts={posts} locale={locale} />
    </div>
  </section>
</BaseLayout>
