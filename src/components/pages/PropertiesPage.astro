---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../SectionHeading.astro';
import PropertyGrid from '../PropertyGrid.astro';
import { getDictionary } from '../../i18n';
import { getProperties } from '../../utils/content';
import {
  buildOrganizationJsonLd,
  buildWebPageJsonLd,
  buildBreadcrumbJsonLd,
} from '../../utils/seo';
import type { Locale } from '../../content.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const path = locale === 'es' ? '/es/propiedades' : '/properties';
const properties = await getProperties(locale);
const rootPath = locale === 'es' ? '/es' : '/';

const jsonLd = [
  buildOrganizationJsonLd(),
  buildWebPageJsonLd(t.seoPropertiesTitle, path, t.seoPropertiesDescription),
  buildBreadcrumbJsonLd([
    { name: 'Home', url: rootPath },
    { name: t.properties, url: path },
  ]),
];
---

<BaseLayout
  title={t.seoPropertiesTitle}
  description={t.seoPropertiesDescription}
  locale={locale}
  path={path}
  jsonLd={jsonLd}
>
  <section class="section-pad pb-10 pt-32 md:pt-40">
    <div class="container-site">
      <div data-reveal>
        <SectionHeading
          align="center"
          as="h1" eyebrow={t.propertiesEyebrow}
          title={t.propertiesTitle}
          description={t.propertiesSubtitle}
        />
      </div>
    </div>
  </section>
  <section class="pb-20 md:pb-28">
    <div class="container-site">
      <PropertyGrid properties={properties} locale={locale} initialVisible={6} withLoadMore />
    </div>
  </section>
</BaseLayout>
