---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../SectionHeading.astro';
import { siteConfig } from '../../config/site';
import { getDictionary } from '../../i18n';
import {
  buildOrganizationJsonLd,
  buildWebPageJsonLd,
  buildBreadcrumbJsonLd,
} from '../../utils/seo';
import { absoluteUrl } from '../../utils/content';
import type { Locale } from '../../content.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const path = locale === 'es' ? '/es/citas' : '/appointments';
const rootPath = locale === 'es' ? '/es' : '/';

const jsonLd = [
  buildOrganizationJsonLd(),
  buildWebPageJsonLd(t.seoAppointmentsTitle, path, t.seoAppointmentsDescription),
  buildBreadcrumbJsonLd([
    { name: 'Home', url: absoluteUrl(rootPath) },
    { name: t.appointments, url: absoluteUrl(path) },
  ]),
];
---

<BaseLayout
  title={t.seoAppointmentsTitle}
  description={t.seoAppointmentsDescription}
  locale={locale}
  path={path}
  jsonLd={jsonLd}
>
  <section class="section-pad pt-32 md:pt-40">
    <div class="container-site max-w-4xl">
      <div data-reveal>
        <SectionHeading
          align="center"
          eyebrow={t.appointmentsEyebrow}
          title={t.appointmentsTitle}
          description={t.appointmentsIntro}
        />
      </div>
      <div data-reveal class="mt-12 overflow-hidden rounded-[12px] border border-line bg-surface p-2 md:p-4">
        <div
          class="acuity-block-wrapper"
          data-calendar-id={siteConfig.acuity.calendarId}
          data-class-id=""
          data-user-id={siteConfig.acuity.userId}
          data-scheduling-page-group="all"
          data-appointment-type-id={siteConfig.acuity.appointmentTypeId}
          data-category=""
          data-acuity-url={siteConfig.acuity.url}
        >
          <iframe
            title="Schedule Appointment"
            width="100%"
            frameborder="0"
            allow="payment"
            data-iframe-translate=""
          ></iframe>
          <script is:inline src="https://embed.acuityscheduling.com/js/embed.js" type="text/javascript"></script>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>