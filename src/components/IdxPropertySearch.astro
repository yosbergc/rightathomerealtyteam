---
import { siteConfig } from '../config/site';

interface Props {
  placeholder?: string;
}

const { placeholder } = Astro.props;
---

<link rel="preconnect" href="https://idxaddons.com" />
<link rel="preconnect" href="https://cdnjs.cloudflare.com" />
<div class="idx-search">
  <script
    is:inline
    defer
    id="idxaddons-autocomplete-script"
    src={siteConfig.idxSearchSrc}
    data-agentid={siteConfig.idxSearchAgentId}
    {...(placeholder ? { 'data-placeholder': placeholder } : {})}
  ></script>
</div>
