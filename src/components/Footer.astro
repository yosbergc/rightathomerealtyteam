---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import NewsletterForm from './NewsletterForm.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { siteConfig } from '../config/site';
import { getDictionary, localizedPath } from '../i18n';
import type { Locale } from '../content.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const browseLinks = [
  { label: t.propertySearch, href: '/search' },
  { label: t.contactUs, href: localizedPath('/contact', locale) },
];

const companyLinks = [
  { label: t.about, href: localizedPath('/about', locale) },
  { label: t.agent, href: localizedPath('/join', locale) },
  { label: t.testimonials, href: localizedPath('/#testimonial', locale) },
  { label: t.blog, href: localizedPath('/blog', locale) },
  { label: t.faqs, href: localizedPath('/#faq', locale) },
];
---

<footer class="bg-black text-white">
  <div class="container-site pt-16 pb-10 md:pt-20">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-[22px] font-semibold leading-tight tracking-[-0.02em] md:text-[24px]">
          {t.newsletterTitle}
        </h2>
        <NewsletterForm locale={locale} />
      </div>
      <div class="text-right">
        <Logo class="justify-end text-white" />
        <p class="mt-4 text-sm text-white/70">{t.footerAddress}</p>
      </div>
    </div>

    <div class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-white/40">{t.footerContact}</p>
        <ul class="grid gap-3 text-sm">
          <li>
            <a href={siteConfig.emailHref} class="text-white/85 transition-colors hover:text-white">
              {t.contactEmail}
            </a>
          </li>
          <li>
            <a href={siteConfig.phoneHref} class="text-white/85 transition-colors hover:text-white">
              {t.contactPhone}
            </a>
          </li>
        </ul>
      </div>
      <div>
        <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-white/40">{t.browse}</p>
        <ul class="grid gap-3 text-sm">
          {browseLinks.map((link) => (
            <li>
              <a href={link.href} class="text-white/85 transition-colors hover:text-white">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-white/40">{t.company}</p>
        <ul class="grid gap-3 text-sm">
          {companyLinks.map((link) => (
            <li>
              <a href={link.href} class="text-white/85 transition-colors hover:text-white">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-white/40">Social</p>
        <ul class="flex gap-2">
          {siteConfig.socials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="inline-flex h-10 w-10 items-center justify-center rounded-[4px] bg-white/10 text-white transition-colors hover:bg-white/20"
              >
                <Icon name={social.label.toLowerCase() as 'facebook' | 'instagram' | 'tiktok'} class="h-5 w-5" />
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-8">
          <LanguageSwitcher
            locale={locale}
            enUrl={localizedPath('/', 'en')}
            esUrl={localizedPath('/', 'es')}
            class="text-white"
          />
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-site flex flex-col items-center justify-between gap-3 py-6 text-[13px] text-white/60 md:flex-row">
      <p>
        ©{new Date().getFullYear()} {t.copyright}
      </p>
    </div>
  </div>
</footer>