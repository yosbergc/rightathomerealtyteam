---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Testimonial } from '../i18n/types';
import { imageMap } from '../utils/images';

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;
---

<div data-carousel class="relative">
  <div
    data-carousel-track
    class="carousel-track flex snap-x snap-mandatory gap-6 overflow-x-auto pb-[72px]"
  >
    {testimonials.map((testimonial) => (
      <div
        data-carousel-slide
        class="w-full min-w-[88%] snap-start md:min-w-[70%] lg:min-w-[64%]"
        aria-label={`${testimonial.name}`}
      >
        <figure class="grid gap-6 rounded-[12px] border border-white/10 bg-white/5 p-6 md:grid-cols-[auto_1fr] md:p-8">
          <div class="relative mx-auto h-56 w-44 shrink-0 md:mx-0">
            <span class="absolute -left-3 -top-3 block h-14 w-14 rounded-[20px] bg-brand" aria-hidden="true"></span>
            <span class="absolute -bottom-3 -right-3 block h-14 w-14 rounded-[20px] bg-quote" aria-hidden="true"></span>
            <Image
              src={imageMap[testimonial.image as keyof typeof imageMap]}
              alt={testimonial.name}
              class="relative h-full w-full rounded-[12px] object-cover"
              width={896}
              height={1200}
            />
            <span class="badge-pill absolute bottom-3 left-3 bg-black/55">{testimonial.badge}</span>
          </div>
          <div class="flex flex-col justify-center">
            <Icon name="house" class="quote-mark h-[11px] w-3" />
            <blockquote class="mt-4 text-[20px] font-normal leading-[1.4] tracking-[-0.02em] text-white md:text-[24px]">
              “{testimonial.quote}”
            </blockquote>
            <figcaption class="mt-5">
              <p class="font-semibold text-white">{testimonial.name}</p>
              <p class="mt-0.5 text-sm text-white/60">{testimonial.tag}</p>
            </figcaption>
          </div>
        </figure>
      </div>
    ))}
  </div>
  <div class="absolute bottom-0 right-0 flex gap-3">
    <button
      type="button"
      data-carousel-prev
      aria-label="Previous"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-black/55 text-white transition-colors hover:bg-black/75"
    >
      <Icon name="arrow-left" class="h-5 w-5" />
    </button>
    <button
      type="button"
      data-carousel-next
      aria-label="Next"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-black/55 text-white transition-colors hover:bg-black/75"
    >
      <Icon name="arrow-right" class="h-5 w-5" />
    </button>
  </div>
</div>