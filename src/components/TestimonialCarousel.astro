---
import Icon from './Icon.astro';
import type { Testimonial } from '../i18n/types';

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;
---

<div data-carousel class="relative">
  <div
    data-carousel-track
    class="carousel-track flex snap-x snap-mandatory gap-6 overflow-x-auto pb-[72px]"
  >
    {testimonials.map((testimonial) => (
      <div
        data-carousel-slide
        class="w-full min-w-[88%] snap-start md:min-w-[70%] lg:min-w-[55%]"
        aria-label={`${testimonial.name}`}
      >
        <figure class="flex h-full flex-col rounded-[12px] border border-white/10 bg-white/5 p-8 md:p-10">
          <div class="flex items-center gap-2">
            <Icon name="house" class="quote-mark h-[11px] w-3" />
            <span class="h-px flex-1 bg-white/15" aria-hidden="true"></span>
          </div>
          <blockquote class="mt-6 flex-1 text-[19px] font-normal leading-[1.5] tracking-[-0.02em] text-white md:text-[22px]">
            “{testimonial.quote}”
          </blockquote>
          <figcaption class="mt-8">
            <p class="font-semibold text-white">{testimonial.name}</p>
            <p class="mt-0.5 text-sm text-white/60">{testimonial.tag}</p>
          </figcaption>
        </figure>
      </div>
    ))}
  </div>
  <div class="absolute bottom-0 right-0 flex gap-3">
    <button
      type="button"
      data-carousel-prev
      aria-label="Previous"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-black/55 text-white transition-colors hover:bg-black/75"
    >
      <Icon name="arrow-left" class="h-5 w-5" />
    </button>
    <button
      type="button"
      data-carousel-next
      aria-label="Next"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-black/55 text-white transition-colors hover:bg-black/75"
    >
      <Icon name="arrow-right" class="h-5 w-5" />
    </button>
  </div>
</div>