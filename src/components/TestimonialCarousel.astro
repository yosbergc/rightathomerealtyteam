---
import Icon from './Icon.astro';
import type { Testimonial } from '../i18n/types';

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;
---

<div data-carousel class="relative">
  <div
    data-carousel-track
    class="carousel-track flex snap-x snap-mandatory gap-6 overflow-x-auto pb-[72px]"
  >
    {testimonials.map((testimonial) => (
      <div
        data-carousel-slide
        class="w-full min-w-[88%] snap-start md:min-w-[70%] lg:min-w-[55%]"
        aria-label={`${testimonial.name}`}
      >
        <figure class="flex h-full flex-col rounded-[12px] border border-line bg-white p-8 shadow-[0_18px_40px_-24px_rgba(0,0,0,0.25)] md:p-10">
          <div class="flex items-center gap-1.5" aria-label="5-star rating">
            {Array.from({ length: 5 }).map(() => (
              <Icon name="star" class="h-5 w-5 text-[#C89B3C]" />
            ))}
          </div>
          <blockquote class="mt-6 flex-1 text-[19px] font-normal leading-[1.5] tracking-[-0.02em] text-[#1a1a1a] md:text-[22px]">
            “{testimonial.quote}”
          </blockquote>
          <figcaption class="mt-8 border-t border-line pt-5">
            <p class="font-semibold text-black">{testimonial.name}</p>
            <p class="mt-0.5 text-sm text-black/60">{testimonial.tag}</p>
          </figcaption>
        </figure>
      </div>
    ))}
  </div>
  <div class="absolute bottom-0 right-0 flex gap-3">
    <button
      type="button"
      data-carousel-prev
      aria-label="Previous"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-black text-white transition-colors hover:bg-[#C89B3C]"
    >
      <Icon name="arrow-left" class="h-5 w-5" />
    </button>
    <button
      type="button"
      data-carousel-next
      aria-label="Next"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-black text-white transition-colors hover:bg-[#C89B3C]"
    >
      <Icon name="arrow-right" class="h-5 w-5" />
    </button>
  </div>
</div>