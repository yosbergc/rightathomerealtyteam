---
interface Props {
  class?: string;
  size?: string;
}

const { class: className = '', size = 'h-16 md:h-20' } = Astro.props;
---

<a
  href="/"
  class={`inline-flex items-center ${className}`}
  aria-label="Right At Home Realty home"
>
  <img
    src="/og-image.png"
    alt="Right At Home Realty Team"
    width={955}
    height={521}
    class={`w-auto object-contain ${size}`}
  />
</a>