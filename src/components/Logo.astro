---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<a
  href="/"
  class={`inline-flex items-center ${className}`}
  aria-label="Right At Home Realty home"
>
  <img
    src="/og-image.png"
    alt="Right At Home Realty Team"
    width={955}
    height={521}
    class="h-10 w-auto object-contain md:h-11"
  />
</a>