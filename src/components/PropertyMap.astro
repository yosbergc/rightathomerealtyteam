---
import { siteConfig } from '../config/site';
import { getDictionary } from '../i18n';
import type { Locale } from '../content.config';

interface Props {
  locale: Locale;
  embedUrl?: string;
}

const { locale, embedUrl = siteConfig.mapEmbed } = Astro.props;
const t = getDictionary(locale);
---

<h2 class="heading-section">{t.location}</h2>
<div class="mt-6 overflow-hidden rounded-[12px] border border-line">
  <iframe
    src={embedUrl}
    title={t.location}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    class="h-[320px] w-full border-0 md:h-[420px]"
  ></iframe>
</div>