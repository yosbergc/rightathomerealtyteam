---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { getDictionary } from '../i18n';
import { teamPhotos } from '../utils/images';
import type { Locale } from '../content.config';

interface Props {
  locale: Locale;
  buttonClass?: string;
  class?: string;
  dropUp?: boolean;
  label?: string;
}

const {
  locale,
  buttonClass = 'btn btn-primary w-full py-3',
  class: className = '',
  dropUp = false,
  label,
} = Astro.props;
const t = getDictionary(locale);
const members = [...t.teamMembers].sort(() => Math.random() - 0.5);
const buttonLabel = label ?? t.contactAgent;
---

<div class:list={['contact-agents', dropUp && 'drop-up', className]} data-contact-agents>
  <button
    type="button"
    data-contact-agents-toggle
    aria-expanded="false"
    aria-haspopup="true"
    class={buttonClass}
  >
    {buttonLabel}
  </button>
  <div data-contact-agents-panel class="contact-agents-panel" role="menu" aria-label={t.contactAgent}>
    {members.map((member) => (
      <a
        href={`tel:${member.phone.replace(/[^+\d]/g, '')}`}
        class="flex items-center gap-3 rounded-[8px] px-3 py-2.5 transition-colors hover:bg-surface"
        role="menuitem"
      >
        <Image
          src={teamPhotos[member.photo as keyof typeof teamPhotos]}
          alt={member.name}
          width={80}
          height={80}
          loading="lazy"
          class="h-10 w-10 shrink-0 rounded-full border border-line object-cover object-top"
        />
        <span class="min-w-0 flex-1">
          <span class="block truncate text-sm font-semibold text-white">{member.name}</span>
          <span class="mt-0.5 flex items-center gap-0.5" aria-label="5-star rating">
            {Array.from({ length: 5 }).map(() => (
              <Icon name="star" class="h-3.5 w-3.5 text-amber-400" />
            ))}
          </span>
        </span>
        <Icon name="phone" class="h-5 w-5 shrink-0 text-brand" />
      </a>
    ))}
  </div>
</div>

<style>
  .contact-agents {
    position: relative;
  }

  .contact-agents-panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    min-width: 15rem;
    max-width: min(20rem, calc(100vw - 2rem));
    z-index: 50;
    padding: 8px;
    background-color: #161616;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.3);
    visibility: hidden;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;
  }

  .contact-agents.drop-up .contact-agents-panel {
    top: auto;
    bottom: calc(100% + 8px);
    transform: translateY(-8px);
  }

  .contact-agents[data-open] .contact-agents-panel {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-contact-agents]').forEach((container) => {
    const toggle = container.querySelector<HTMLButtonElement>('[data-contact-agents-toggle]');
    const panel = container.querySelector<HTMLElement>('[data-contact-agents-panel]');
    if (!toggle || !panel) return;

    const open = () => {
      const gap = 12;
      const rect = toggle.getBoundingClientRect();
      const panelHeight = panel.offsetHeight || 220;
      const spaceBelow = window.innerHeight - rect.bottom;
      const spaceAbove = rect.top;
      const shouldDropUp = spaceBelow < panelHeight + gap && spaceAbove > spaceBelow;
      container.classList.toggle('drop-up', shouldDropUp);
      container.setAttribute('data-open', '');
      toggle.setAttribute('aria-expanded', 'true');
    };
    const close = () => {
      container.removeAttribute('data-open');
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      if (container.hasAttribute('data-open')) close();
      else open();
    });

    window.addEventListener('resize', () => {
      if (container.hasAttribute('data-open')) open();
    });

    document.addEventListener('click', (event) => {
      if (!container.contains(event.target as Node)) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
    document.addEventListener('scroll', close, { passive: true });
  });
</script>