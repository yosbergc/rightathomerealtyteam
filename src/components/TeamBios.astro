---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { getDictionary } from '../i18n';
import { teamPhotos } from '../utils/images';
import { siteConfig } from '../config/site';
import type { Locale } from '../content.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section class="section-pad bg-surface/40">
  <div class="container-site">
    <div data-reveal>
      <SectionHeading
        eyebrow={t.teamEyebrowAbout}
        title={t.teamTitleAbout}
        description={t.teamIntroAbout}
      />
    </div>
    <div class="mt-14 grid gap-10">
      {t.teamMembers.map((member, index) => (
        <article
          data-reveal
          class:list={[
            'card-surface grid gap-8 overflow-hidden p-6 md:p-8 lg:grid-cols-[280px_1fr] lg:gap-12',
            index % 2 === 1 && 'lg:[&>div:first-child]:order-2',
          ]}
        >
          <div>
            <div class="overflow-hidden rounded-[12px]">
              <Image
                src={teamPhotos[member.photo as keyof typeof teamPhotos]}
                alt={member.name}
                class="aspect-[3/4] w-full object-cover object-top"
                sizes="(max-width: 809px) 100vw, 280px"
              />
            </div>
            <h3 class="heading-page mt-5">{member.name}</h3>
            <p class="mt-1 text-sm font-medium text-brand">{member.title}</p>
          </div>
          <div class="flex flex-col">
            <div class="grid gap-4 text-body">
              {member.bio.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href={`tel:${member.phone.replace(/[^+\d]/g, '')}`}
                class="btn btn-primary px-5 py-2.5 text-sm"
              >
                <Icon name="phone" class="h-4 w-4" />
                {member.phone}
              </a>
              <a href={`mailto:${member.email}`} class="btn btn-outline-dark px-5 py-2.5 text-sm">
                <Icon name="mail" class="h-4 w-4" />
                {member.email}
              </a>
              <div class="flex items-center gap-2">
                {siteConfig.socials.map((social) => (
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${social.label} - ${member.name}`}
                    class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-surface text-ink transition-colors hover:bg-brand hover:text-white"
                  >
                    <Icon name={social.label.toLowerCase() as 'facebook' | 'instagram' | 'tiktok' | 'x'} class="h-4 w-4" />
                  </a>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>