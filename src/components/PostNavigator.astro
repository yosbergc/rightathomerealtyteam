---
import Icon from './Icon.astro';
import { postUrl, type Post } from '../utils/content';
import { getDictionary } from '../i18n';
import type { Locale } from '../content.config';

interface Props {
  previous?: Post;
  next?: Post;
  locale: Locale;
}

const { previous, next, locale } = Astro.props;
const t = getDictionary(locale);
---

{
  (previous || next) && (
    <nav aria-label="Pagination" class="mt-12 grid gap-4 border-t border-line pt-8 sm:grid-cols-2">
      {
        previous && (
          <a
            href={postUrl(previous, locale)}
            class="group flex items-center gap-3 rounded-[12px] border border-line p-5 transition-colors hover:border-brand"
          >
            <Icon name="arrow-left" class="h-5 w-5 shrink-0 text-muted transition-colors group-hover:text-brand" />
            <span>
              <span class="block text-xs uppercase tracking-wide text-muted">{t.previous}</span>
              <span class="mt-1 block font-semibold text-white">{previous.data.title}</span>
            </span>
          </a>
        )
      }
      {
        next && (
          <a
            href={postUrl(next, locale)}
            class="group flex items-center justify-end gap-3 rounded-[12px] border border-line p-5 text-right transition-colors hover:border-brand sm:col-start-2"
          >
            <span>
              <span class="block text-xs uppercase tracking-wide text-muted">{t.next}</span>
              <span class="mt-1 block font-semibold text-white">{next.data.title}</span>
            </span>
            <Icon name="arrow-right" class="h-5 w-5 shrink-0 text-muted transition-colors group-hover:text-brand" />
          </a>
        )
      }
    </nav>
  )
}