---
interface Props {
  value: number;
  suffix: string;
  label: string;
  color: 'black' | 'brand';
}

const { value, suffix, label, color } = Astro.props;
---

<div data-reveal>
  <span
    data-counter={value}
    data-suffix={suffix}
    class="stat-number"
    style={`color: ${color === 'brand' ? '#0056c7' : '#000'}`}
  >
    {value}{suffix}
  </span>
  <p class="mt-1 text-sm text-muted">{label}</p>
</div>