---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { getDictionary } from '../i18n';
import type { Property } from '../utils/content';
import type { Locale } from '../content.config';

interface Props {
  property: Property;
  locale: Locale;
}

const { property, locale } = Astro.props;
const t = getDictionary(locale);
const images = [property.data.coverImage, ...property.data.gallery];
---

<div data-gallery class="grid gap-5 lg:grid-cols-3">
  <button
    type="button"
    data-gallery-item
    class="group relative col-span-2 overflow-hidden rounded-[12px] text-left"
  >
    <Image
      src={images[0]}
      alt={property.data.title}
      class="aspect-[4/3] h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
      sizes="(max-width: 809px) 100vw, 66vw"
    />
    <span class="absolute bottom-4 right-4 inline-flex items-center gap-2 rounded-[6px] bg-black/55 px-3 py-2 text-sm font-medium text-white backdrop-blur-[4px]">
      <Icon name="photo" class="h-4 w-4" />
      {t.showAll}
    </span>
  </button>
  <div class="grid gap-5">
    <button type="button" data-gallery-item class="group overflow-hidden rounded-[12px] text-left">
      <Image
        src={images[1] ?? images[0]}
        alt={property.data.title}
        class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
        sizes="(max-width: 809px) 100vw, 33vw"
      />
    </button>
    <div class="grid grid-cols-2 gap-5">
      <button type="button" data-gallery-item class="group overflow-hidden rounded-[12px] text-left">
        <Image
          src={images[2] ?? images[0]}
          alt={property.data.title}
          class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          sizes="(max-width: 809px) 50vw, 16vw"
        />
      </button>
      <button type="button" data-gallery-item class="group overflow-hidden rounded-[12px] text-left">
        <Image
          src={images[3] ?? images[0]}
          alt={property.data.title}
          class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          sizes="(max-width: 809px) 50vw, 16vw"
        />
      </button>
    </div>
  </div>
</div>

<div data-lightbox class="lightbox" role="dialog" aria-modal="true" aria-label={property.data.title}>
  <button
    type="button"
    data-lightbox-close
    class="absolute right-5 top-5 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
    aria-label="Close"
  >
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M5 5l10 10M15 5 5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  </button>
  <button
    type="button"
    data-lightbox-prev
    class="absolute left-5 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
    aria-label="Previous image"
  >
    <Icon name="arrow-left" class="h-5 w-5" />
  </button>
  <img data-lightbox-image alt="" class="max-h-[82vh] max-w-[90vw] rounded-[8px] object-contain" />
  <button
    type="button"
    data-lightbox-next
    class="absolute right-5 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
    aria-label="Next image"
  >
    <Icon name="arrow-right" class="h-5 w-5" />
  </button>
</div>