---
import { Image } from 'astro:assets';
import { categoryUrl, type Category } from '../utils/content';
import type { Locale } from '../content.config';

interface Props {
  category: Category;
  locale: Locale;
  index: number;
}

const { category, locale, index } = Astro.props;
---

<a
  href={categoryUrl(category, locale)}
  class="group block overflow-hidden rounded-[8px] border border-line transition-shadow duration-300 hover:shadow-lg"
>
  <div class="relative aspect-[4/3] overflow-hidden">
    <Image
      src={category.data.heroImage}
      alt={category.data.name}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
      sizes="(max-width: 809px) 100vw, (max-width: 1199px) 50vw, 25vw"
    />
    <span class="absolute inset-0 bg-black/20" aria-hidden="true"></span>
  </div>
  <div class="flex items-center gap-3 bg-surface px-5 py-4">
    <span class="icon-chip h-9 w-9 shrink-0 bg-white text-[15px] font-semibold text-black shadow-sm">
      {index}
    </span>
    <span class="text-[18px] font-semibold text-white">{category.data.name}</span>
  </div>
</a>