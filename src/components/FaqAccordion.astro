---
import Icon from './Icon.astro';
import type { Faq } from '../i18n/types';

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;
---

<div class="mt-12 divide-y divide-line border-y border-line">
  {faqs.map((faq) => (
    <div data-faq-item>
      <h3>
        <button
          type="button"
          data-faq-toggle
          class="flex w-full items-center justify-between gap-4 py-5 text-left"
          aria-expanded="false"
        >
          <span class="text-[17px] font-semibold text-black">{faq.question}</span>
          <Icon name="chevron-down" class="faq-icon h-5 w-5 shrink-0 text-muted" />
        </button>
      </h3>
      <div class="faq-answer">
        <div>
          <p class="pb-5 pr-8 text-body">{faq.answer}</p>
        </div>
      </div>
    </div>
  ))}
</div>