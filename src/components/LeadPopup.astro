---
import Icon from './Icon.astro';
import { siteConfig } from '../config/site';
import { getDictionary } from '../i18n';
import type { Locale } from '../content.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const honeypots = [
  'botcheck',
  'website',
  'company',
  'title',
  'description',
  'feedback',
  'notes',
  'details',
  'remarks',
  'comments',
];

const inputClass =
  'w-full rounded-[4px] border border-line bg-surface px-4 py-3 text-[15px] text-ink placeholder:text-[#8a8a8a] focus:border-brand';
const labelClass = 'mb-1.5 block text-sm font-semibold text-white';
const errorClass = 'mt-1 block min-h-[16px] text-[13px] text-red-600';
---

<div data-lead-popup class="lead-popup">
  <div data-lead-panel class="lead-popup-panel" role="dialog" aria-modal="false" aria-label={t.leadTitle}>
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-lg font-semibold tracking-[-0.02em] text-white">{t.leadTitle}</h2>
        <p class="mt-1 text-sm leading-snug text-muted">{t.leadSubtitle}</p>
      </div>
      <button
        type="button"
        data-lead-close
        class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-muted transition-colors hover:bg-surface hover:text-white"
        aria-label={t.leadClose}
      >
        <Icon name="close" class="h-5 w-5" />
      </button>
    </div>
    <form
      data-form
      data-endpoint={siteConfig.formEndpoint}
      data-access-key={siteConfig.web3formsAccessKey}
      data-sending={t.leadSending}
      class="mt-5 grid gap-4"
      novalidate
    >
      <input type="hidden" name="subject" value={`Quick request from ${siteConfig.name} website`} />
      <input type="hidden" name="from_name" value={siteConfig.name} />
      <div>
        <label class={labelClass} for="lead-name">{t.leadNameLabel}</label>
        <input
          id="lead-name"
          type="text"
          name="name"
          placeholder={t.leadNamePlaceholder}
          required
          data-required
          data-msg-required={t.validationRequired}
          class={inputClass}
        />
        <span class={errorClass} data-error aria-live="polite"></span>
      </div>
      <div>
        <label class={labelClass} for="lead-phone">{t.leadPhoneLabel}</label>
        <input
          id="lead-phone"
          type="tel"
          name="phone"
          placeholder={t.leadPhonePlaceholder}
          required
          data-required
          data-msg-required={t.validationRequired}
          class={inputClass}
        />
        <span class={errorClass} data-error aria-live="polite"></span>
      </div>
      <div>
        <label class={labelClass} for="lead-message">{t.leadMessageLabel}</label>
        <textarea
          id="lead-message"
          name="message"
          placeholder={t.leadMessagePlaceholder}
          required
          data-required
          data-msg-required={t.validationMessage}
          rows={3}
          class={`${inputClass} resize-y`}
        ></textarea>
        <span class={errorClass} data-error aria-live="polite"></span>
      </div>
      <button type="submit" class="btn btn-primary w-full py-3" data-submit>
        <span data-submit-label>{t.leadSend}</span>
      </button>
      {honeypots.map((name) => (
        <input
          type="text"
          name={name}
          tabindex="-1"
          autocomplete="off"
          class="absolute -left-[9999px] h-0 w-0 opacity-0"
          aria-hidden="true"
        />
      ))}
    </form>
    <div data-form-status aria-live="polite">
      <p
        class="mt-4 hidden rounded-[4px] border border-green-300 bg-green-50 px-4 py-3 text-sm text-green-800"
        data-status-success
      >
        <strong>{t.leadSuccessTitle}.</strong> {t.leadSuccessMessage}
      </p>
      <p
        class="mt-4 hidden rounded-[4px] border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800"
        data-status-error
      >
        <strong>{t.leadErrorTitle}.</strong> {t.leadErrorMessage}
      </p>
    </div>
  </div>
  <button
    type="button"
    data-lead-toggle
    class="lead-popup-toggle"
    aria-expanded="false"
    aria-haspopup="dialog"
  >
    <Icon name="chat" class="h-5 w-5 shrink-0" />
    <span>{t.leadHelp}</span>
  </button>
</div>

<style>
  .lead-popup {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    pointer-events: none;
  }

  .lead-popup-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 12px);
    width: min(360px, calc(100vw - 40px));
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding: 20px;
    background-color: #161616;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    box-shadow: 0 24px 48px -20px rgb(0 0 0 / 0.6);
    visibility: hidden;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;
    pointer-events: none;
  }

  .lead-popup[data-open] .lead-popup-panel {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .lead-popup-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-radius: 999px;
    background-color: var(--color-brand);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    box-shadow: 0 16px 32px -12px rgb(200 155 60 / 0.5);
    transition: background-color 0.2s ease;
    pointer-events: auto;
  }

  .lead-popup-toggle:hover {
    background-color: #a87f2f;
  }

  @media (max-width: 479px) {
    .lead-popup {
      right: 14px;
      bottom: 14px;
    }
    .lead-popup-toggle {
      padding: 11px 14px;
      font-size: 14px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-lead-popup]').forEach((popup) => {
    const toggle = popup.querySelector<HTMLButtonElement>('[data-lead-toggle]');
    const closeBtn = popup.querySelector<HTMLButtonElement>('[data-lead-close]');

    const open = () => {
      popup.setAttribute('data-open', '');
      toggle?.setAttribute('aria-expanded', 'true');
    };
    const close = () => {
      popup.removeAttribute('data-open');
      toggle?.setAttribute('aria-expanded', 'false');
    };

    toggle?.addEventListener('click', (event) => {
      event.stopPropagation();
      if (popup.hasAttribute('data-open')) close();
      else open();
    });
    closeBtn?.addEventListener('click', close);
    document.addEventListener('click', (event) => {
      if (!popup.contains(event.target as Node)) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  });
</script>